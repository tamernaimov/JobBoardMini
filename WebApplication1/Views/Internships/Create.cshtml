@model JobBoardMini.Web.ViewModels.Internships.InternshipCreateViewModel

@{
    ViewData["Title"] = "Добави стаж";
}

<h1>Добави нов стаж</h1>

<form asp-controller="Internships" asp-action="Create" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Internship.Position" class="form-label">Позиция</label>
        <input asp-for="Internship.Position" class="form-control" />
        <span asp-validation-for="Internship.Position" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Internship.CompanyId" class="form-label">Компания</label>
        <select asp-for="Internship.CompanyId" class="form-select">
            <option value="">Избери компания</option>
            @foreach (var company in Model.Companies)
            {
                <option value="@company.Id">@company.Name</option>
            }
        </select>
        <span asp-validation-for="Internship.CompanyId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Internship.CategoryId" class="form-label">Категория</label>
        <select asp-for="Internship.CategoryId" class="form-select">
            <option value="">Избери категория</option>
            @foreach (var category in Model.Categories)
            {
                <option value="@category.Id">@category.Name</option>
            }
        </select>
        <span asp-validation-for="Internship.CategoryId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Internship.City" class="form-label">Град</label>
        <input asp-for="Internship.City" class="form-control" />
        <span asp-validation-for="Internship.City" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Internship.DurationWeeks" class="form-label">Продължителност (седмици)</label>
        <input asp-for="Internship.DurationWeeks" class="form-control" />
        <span asp-validation-for="Internship.DurationWeeks" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Internship.Description" class="form-label">Описание</label>
        <textarea asp-for="Internship.Description" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Internship.Description" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Запази</button>
    <a asp-action="Index" class="btn btn-secondary">Назад</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}