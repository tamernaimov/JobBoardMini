@model JobBoardMini.Web.ViewModels.Internships.InternshipsIndexViewModel

@{
    ViewData["Title"] = "Ученически стажове";
}

<h1>Ученически стажове</h1>

<a href="/Internships/Create" class="btn btn-primary">
    Добави нов стаж
</a>
@if (!Model.Internships.Any())
{
    <p>Все още няма добавени стажове.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Позиция</th>
                <th>Компания</th>
                <th>Категория</th>
                <th>Град</th>
                <th>Продължителност (седмици)</th>
                <th>Описание</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var internship in Model.Internships)
            {
                <tr>
                    <td>@internship.Position</td>
                    <td>@internship.Organization</td>
                    <td>@internship.Category</td>
                    <td>@internship.City</td>
                    <td>@internship.DurationWeeks</td>
                    <td>@internship.Description</td>
                </tr>
            }
        </tbody>
    </table>
}